# Copy to .env.docker and adjust ports if needed:
#   copy .env.docker.example .env.docker   (Windows PowerShell: Copy-Item)

# --- Postgres (must match docker/postgres/init role password only for authenticator; see 01-schema.sql) ---
POSTGRES_PASSWORD=your-super-secret-and-long-postgres-password

# --- JWT / Supabase-compatible API keys (must stay together; from Supabase self-host .env.example) ---
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyAgCiAgICAicm9sZSI6ICJhbm9uIiwKICAgICJpc3MiOiAic3VwYWJhc2UtZGVtbyIsCiAgICAiaWF0IjogMTY0MTc2OTIwMCwKICAgICJleHAiOiAxNzk5NTM1NjAwCn0.dc_X5iR_VP_qT0zsiyj_I_OZ2T9FtRU2BBNWN8Bu4GE
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyAgCiAgICAicm9sZSI6ICJzZXJ2aWNlX3JvbGUiLAogICAgImlzcyI6ICJzdXBhYmFzZS1kZW1vIiwKICAgICJpYXQiOiAxNjQxNzY5MjAwLAogICAgImV4cCI6IDE3OTk1MzU2MDAKfQ.DaYlNEoUrrEn2Ig7tqibS-PHK5vgusbcbo7X36XVt4Q

# --- Public URLs (browser + GoTrue redirects; use localhost + published ports) ---
API_EXTERNAL_URL=http://localhost:54321
SUPABASE_PUBLIC_URL=http://localhost:54321
SITE_URL=http://localhost:3000
ADDITIONAL_REDIRECT_URLS=http://localhost:3000,http://localhost:3000/auth/callback
NEXT_PUBLIC_API_URL=http://localhost:8001

# --- Auth bypass (demo / broken GoTrue). Set false to require real login. ---
AUTH_DISABLED=true
NEXT_PUBLIC_AUTH_DISABLED=true
DEMO_USER_ID=00000000-0000-4000-8000-000000000001

# --- Ollama ---
OLLAMA_MODEL=llama3
OLLAMA_HOST_PORT=11434

# --- Compose ports ---
SUPABASE_GATEWAY_PORT=54321
BACKEND_PORT=8001
FRONTEND_PORT=3000
MAILPIT_UI_PORT=8025

# --- Optional ---
JWT_EXPIRY=3600
CORS_ORIGINS=http://localhost:3000
CONTEXT_WINDOW_MESSAGES=20
SYSTEM_PROMPT=You are a helpful assistant.
SMTP_ADMIN_EMAIL=admin@localhost
